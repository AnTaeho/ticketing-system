spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ticketing?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: your_local_db_password

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  data:
    redis:
      host: localhost
      port: 6379

# 로컬에서 바꿔 볼 만한 설정. 주석을 풀어 쓴다. 나머지 ticketing.* 기본값은 application.yml에 있다
# ticketing.gate.enabled: false          # Redis 게이트 없이 DB 판정만으로 선점(부하 테스트 비교용)
# ticketing.queue.required: false        # 줄을 서지 않고 바로 선점(부하 테스트 비교용)
# ticketing.queue.capacity: 200          # 좌석 화면에 동시에 들어갈 수 있는 인원
# ticketing.seed.enabled: false          # 띄울 때 시연용 공연을 만들지 않는다
# ticketing.fake-pg.delay-min: 200ms     # 가짜 결제 응답 지연 최소
# ticketing.fake-pg.delay-max: 1200ms    # 가짜 결제 응답 지연 최대
# ticketing.fake-pg.decline-rate: 0.1    # 거절 비율
# ticketing.fake-pg.slow-rate: 0.05      # 타임아웃을 넘길 만큼 느린 응답 비율
