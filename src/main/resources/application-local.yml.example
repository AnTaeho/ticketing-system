spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ticketing?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: your_local_db_password

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  data:
    redis:
      host: localhost
      port: 6379

  kafka:
    bootstrap-servers: localhost:9092

# 예매(V7) 로컬 조정용. 나머지 booking.* 기본값은 application.yml에 있다
booking:
  gate:
    enabled: true              # false면 Redis 게이트 없이 DB 판정만으로 선점(부하 테스트 비교용)
  queue:
    capacity: 200              # 좌석 화면에 동시에 들어갈 수 있는 인원
  fake-pg:
    delay-min-ms: 200          # 가짜 결제 응답 지연 최소
    delay-max-ms: 1200         # 가짜 결제 응답 지연 최대
    decline-rate: 0.1          # 거절 비율
    slow-rate: 0.05            # 타임아웃을 넘길 만큼 느린 응답 비율
    slow-delay-ms: 5000        # 느린 응답의 지연
